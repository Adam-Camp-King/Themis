          "request_ref": "msg_31",
          "tool_call_id": "toolu_01"
        }
      },
      "entity": null,
      "expect": {
        "decision": {
          "kind": "allow"
        },
        "policy_chain": [
          "intent"
        ],
        "audit": {
          "requestor": {
            "id": 100,
            "kind": "agent",
            "scopes": [
              "*"
            ]
          },
          "action": {
            "verb": "invoice.send",
