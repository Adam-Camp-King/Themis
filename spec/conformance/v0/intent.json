{
  "version": "v0",
  "note": "RFC v0.3 (draft) \u00a7 2.7 / \u00a7 5.7 \u2014 action intent. Intent is carried verbatim into the one audit event whether or not the intent policy is registered; the intent policy denies requestors of the configured kinds (default: agent) whose intent has no non-blank summary.",
  "cases": [
    {
      "name": "1. agent with a stated intent is allowed",
      "policies": [
        "intent"
      ],
      "requestor": {
        "id": 100,
        "kind": "agent",
        "tenant_id": 7,
        "scopes": [
          "*"
        ]
      },
      "action": {
        "verb": "invoice.send",
        "resource_type": "invoice",
        "tenant_id": 7,
        "resource_id": 881,
        "intent": {
          "summary": "Send the March invoice the owner asked for",
          "source": "user_request",
          "request_ref": "msg_31",
          "tool_call_id": "toolu_01"
        }
      },
      "entity": null,
      "expect": {
        "decision": {
          "kind": "allow"
        },
        "policy_chain": [
          "intent"
        ],
        "audit": {
          "requestor": {
            "id": 100,
            "kind": "agent",
            "scopes": [
              "*"
            ]
          },
          "action": {
            "verb": "invoice.send",
            "resource_type": "invoice",
            "resource_id": 881
          },
          "intent": {
            "summary": "Send the March invoice the owner asked for",
            "source": "user_request",
            "request_ref": "msg_31",
            "tool_call_id": "toolu_01"
          }
        }
      }
    },
    {
