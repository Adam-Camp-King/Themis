{
  "name": "@themis/policy-dsl",
  "version": "0.0.1",
  "description": "Declarative YAML DSL that compiles to a @themis/core PolicyEngine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": ["bounded", "policy", "dsl", "yaml"],
  "dependencies": {
    "@themis/core": "*",
    "yaml": "^2.6.0"
  },
  "engines": { "node": ">=20" }
}
