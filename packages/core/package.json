{
  "name": "themis-policy",
  "version": "0.2.1",
  "description": "Policy kernel for bounded-autonomy LLM agents. Locks, drafts, scopes, audit, and the agent firewall (identity, quarantine, rate limit, anomaly) \u2014 one engine, pluggable policies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "llm",
    "agents",
    "policy",
    "safety",
    "alignment",
    "bounded-autonomy",
    "multi-tenant",
    "audit"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adam-Camp-King/Themis.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Adam-Camp-King/Themis#readme",
  "bugs": {
    "url": "https://github.com/Adam-Camp-King/Themis/issues"
  }
}
