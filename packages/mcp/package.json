{
  "name": "themis-policy-mcp",
  "version": "0.2.1",
  "description": "Wrap MCP tools with Themis policy evaluation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "bounded",
    "mcp",
    "policy",
    "agent",
    "safety"
  ],
  "dependencies": {
    "themis-policy": "^0.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adam-Camp-King/Themis.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Adam-Camp-King/Themis#readme",
  "bugs": {
    "url": "https://github.com/Adam-Camp-King/Themis/issues"
  }
}
