{
  "name": "@themis/openai",
  "version": "0.0.1",
  "description": "Themis policy kernel adapter for OpenAI function calls / tool calls.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": ["bounded", "openai", "function-calling", "tool", "policy", "agent"],
  "dependencies": { "@themis/core": "*" },
  "engines": { "node": ">=20" }
}
